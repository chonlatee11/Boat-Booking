# Copy filled by `make dev-keys` (never overwrites existing values). Never commit .env.
JWT_ISSUER=boatbooking-dev
JWT_PRIVATE_KEY_B64=
JWT_PUBLIC_KEY_B64=
INTERNAL_TOKEN=
ENV=dev
LOG_LEVEL=info
LOG_FORMAT=json

# CI (Jenkins + SSH agent) — filled by `make ci-keys` (D-21). Never commit .env.
JENKINS_ADMIN_PASSWORD=
JENKINS_AGENT_SSH_PRIVATE_KEY_B64=
JENKINS_AGENT_SSH_PUBKEY=
DOCKER_GID=
CI_REPO_URL=file:///repo

# Harbor registry — filled by `make ci-up` (deploy/ci/harbor-prepare.sh, D-21).
HARBOR_ADMIN_PASSWORD=
HARBOR_DB_PASSWORD=
HARBOR_DATA_DIR=

# Observability (D-20) — dev-only Grafana admin password, bound to 127.0.0.1.
GRAFANA_ADMIN_PASSWORD=admin-dev-only
